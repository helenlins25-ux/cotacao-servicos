# Configuracao do servidor
PORT=3000
# URL base usada para montar os links enviados aos parceiros (opcional; detectada sozinha)
BASE_URL=http://localhost:3000

# Banco de dados (Supabase / PostgreSQL) - use a string do Transaction Pooler
DATABASE_URL=postgresql://postgres.xxxx:SENHA@aws-1-sa-east-1.pooler.supabase.com:6543/postgres

# ---- E-mail ----
# MODO DE ENVIO:
#   mock  = simulado (imprime no log)
#   brevo = API HTTP do Brevo (RECOMENDADO - funciona no Render)
#   smtp  = SMTP nativo (pode ser bloqueado por alguns hosts)
MAIL_MODE=brevo

# Remetente (aparece como quem enviou). Precisa estar verificado no Brevo.
MAIL_FROM="Stractton Cotações <carlos.costa@stractton.com.br>"

# --- Usado quando MAIL_MODE=brevo ---
BREVO_API_KEY=xkeysib-sua-chave-aqui

# --- Usado quando MAIL_MODE=smtp ---
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=carlos.costa@stractton.com.br
SMTP_PASS=sua-senha
