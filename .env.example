# Configuracao do servidor
PORT=3000
# URL base usada para montar os links enviados aos parceiros
BASE_URL=http://localhost:3000

# ---- E-mail ----
# MODO DE ENVIO: "mock" (simulado, imprime no log) ou "smtp" (envio real)
MAIL_MODE=mock

# Usado apenas quando MAIL_MODE=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=seu-email@gmail.com
SMTP_PASS=sua-senha-de-app
MAIL_FROM="Cotacoes <seu-email@gmail.com>"
